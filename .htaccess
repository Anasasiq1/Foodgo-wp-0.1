# ==============================================================================
# Foodgo Gourmet Ordering Platform - Apache, OpenLiteSpeed & Shared Hosting Config
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Protect hidden files, environment files, and sensitive directories
    RewriteRule ^(\.git|\.env|config/|database/|storage/|data/|backups/) - [F,L,NC]

    # 2. Allow direct execution of WordPress Admin Gateway and Plugin Download
    RewriteRule ^admin\.php$ - [L]
    RewriteRule ^index\.php$ - [L]
    RewriteRule ^foodgo-headless-connector\.zip$ - [L]

    # 3. If requested resource is an existing file or directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. SPA Route Fallback:
    # If root index.html exists (e.g. uploaded dist contents directly to public_html), serve it
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
    RewriteRule ^ index.html [L]

    # If dist/index.html exists (e.g. subfolder deployment), serve it
    RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
    RewriteRule ^ dist/index.html [L]

    # Fallback to index.php gateway
    RewriteRule ^ index.php [L]
</IfModule>

# Prevent directory index browsing
Options -Indexes

# Block access to hidden files (.env, .git, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to JSON, log, and configuration files directly
<FilesMatch "\.(json|sql|lock|log|sh|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Custom security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

