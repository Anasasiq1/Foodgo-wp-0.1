# ==============================================================================
# Foodgo Headless Ordering Platform - Apache, OpenLiteSpeed & cPanel/aaPanel Config
# ==============================================================================

# Explicitly set index.html as the primary customer application entry point
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Allow direct execution of WordPress Admin Gateway, plugin, and public config
    RewriteRule ^admin\.php$ - [L]
    RewriteRule ^foodgo-headless-connector\.zip$ - [L]
    RewriteRule ^config/connection-public\.json$ - [L]

    # 2. Block sensitive files & folders
    RewriteRule ^config/connection\.json$ - [F,L,NC]
    RewriteRule ^(\.git|\.env|package\.json|tsconfig\.json|server\.ts) - [F,L,NC]

    # 3. If requested resource is an existing file or directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. SPA Route Fallback:
    # Route all non-file frontend client requests directly to index.html
    RewriteRule . index.html [L]
</IfModule>

# Prevent directory index browsing safely
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Block access to hidden files (.env, .git, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to sensitive file extensions (safe syntax without unsupported regex lookarounds)
<FilesMatch "\.(env|sql|log|sh|lock|ts|tsx)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Specifically protect the connection.json file
<Files "connection.json">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# Custom security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>


