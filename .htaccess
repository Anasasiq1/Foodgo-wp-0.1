# ==============================================================================
# Foodgo Gourmet Ordering Platform - Apache & OpenLiteSpeed Web Server Config
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Protect hidden files, environment files, and sensitive directories
    RewriteRule ^(\.git|\.env|config/|database/|storage/|data/|backups/) - [F,L,NC]

    # 2. Allow direct execution of Installer, Admin Gateway, and Index PHP Gateways
    RewriteRule ^install\.php$ - [L]
    RewriteRule ^install/(.*)$ install/index.php [QSA,L]
    RewriteRule ^admin\.php$ - [L]
    RewriteRule ^index\.php$ - [L]

    # 3. Route clean API requests to /api/index.php
    RewriteRule ^api/(.*)$ api/index.php [QSA,L]
    RewriteRule ^api$ api/index.php [QSA,L]

    # 4. Route HTML portals
    RewriteRule ^admin/?$ admin.html [L]
    RewriteRule ^merchant/?$ merchant.html [L]
    RewriteRule ^delivery/?$ delivery.html [L]

    # 5. If requested resource is an existing file or directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 6. SPA Route Fallback:
    # If root index.html exists (e.g. built dist contents flattened to website root), serve it
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
    RewriteRule ^ index.html [L]

    # If dist/index.html exists (e.g. Vite build in dist subfolder), serve it
    RewriteCond %{DOCUMENT_ROOT}/dist/index.html -f
    RewriteRule ^ dist/index.html [L]

    # Fallback to index.php gateway
    RewriteRule ^ index.php [L]
</IfModule>

# Prevent directory index browsing
Options -Indexes

# Block access to hidden files (.env, .git, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to JSON and SQL data files directly
<FilesMatch "\.(json|sql|lock|log|sh|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Custom security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
