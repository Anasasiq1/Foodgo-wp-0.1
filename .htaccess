# ==============================================================================
# Foodgo Headless Ordering Platform - Apache, OpenLiteSpeed & cPanel/aaPanel Config
# ==============================================================================

# Explicitly set index.html as the primary customer application entry point
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Protect hidden files, environment files, and sensitive directories
    RewriteRule ^(\.git|\.env|config/\.htaccess|database/|storage/|data/|backups/) - [F,L,NC]

    # 2. Allow direct execution of WordPress Admin Gateway and Plugin ZIP
    RewriteRule ^admin\.php$ - [L]
    RewriteRule ^foodgo-headless-connector\.zip$ - [L]

    # 3. If requested resource is an existing file or directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. SPA Route Fallback:
    # Route all frontend client routes directly to index.html
    RewriteCond %{DOCUMENT_ROOT}/index.html -f
    RewriteRule ^ index.html [L]

    # Subfolder / general fallback
    RewriteRule ^ index.html [L]
</IfModule>

# Prevent directory index browsing
Options -Indexes

# Block access to hidden files (.env, .git, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to JSON, SQL, log, and configuration files directly (except connection-public.json)
<FilesMatch "^(?!connection-public\.json$).*\.(json|sql|lock|log|sh|env)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Custom security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

